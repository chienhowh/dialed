# Canonical application URL used by Next.js metadata.
# Set this to the deployed origin in preview and production environments.
APP_URL=http://localhost:3000

# Supabase public project configuration. These values are safe to expose to
# the browser because private data is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Local integration tests only. Never expose this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
